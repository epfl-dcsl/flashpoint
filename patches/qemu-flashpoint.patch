+/* FlashPoint instruction helpers */
+
+void helper_exit_anchor(CPURISCVState *env,
+    target_ulong jump_address, target_ulong _unused)
+{
+    if (!(env->priv == PRV_M)) {
+        riscv_raise_exception(env, RISCV_EXCP_ILLEGAL_INST, GETPC());
+    }
+    
+    /* jump_address: address to jump to after locking the pmp entry 0 */
+    int ret = riscv_exit_anchor(env, jump_address, _unused);
+ 
+    if(ret != 0) {
+        riscv_raise_exception(env, ret, GETPC());
+    }
+}
+
+target_ulong helper_enter_anchor(CPURISCVState *env,
+    target_ulong exit_address, target_ulong exit_region_size)
+{
+    if (!(env->priv == PRV_M)) {
+        riscv_raise_exception(env, RISCV_EXCP_ILLEGAL_INST, GETPC());
+    }
+    
+    target_ulong anchor_entry_addr = 0;
+    int ret = riscv_enter_anchor(env, exit_address, exit_region_size, &anchor_entry_addr);
+ 
+    if(ret != 0) {
+        riscv_raise_exception(env, ret, GETPC());
+    }
+    return anchor_entry_addr;
+}

diff --git a/target/riscv/flashpoint.c b/target/riscv/flashpoint.c
new file mode 100644
index 0000000000000000000000000000000000000000..54f864953b357847cd74a1fe7ecab311a6f299fe
--- /dev/null
+++ b/target/riscv/flashpoint.c
@@ -0,0 +1,134 @@
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/qemu-print.h"
+#include "cpu.h"
+#include "cpu_bits.h"
+#include "flashpoint.h"
+#include "qemu/main-loop.h"
+#include "exec/exec-all.h"
+#include "pmp.h"
+
+static inline RISCVException riscv_xflashpoint_check(CPURISCVState *env) {
+    /* ensure the FlashPoint (and PMP) extension is enabled */
+    if (!riscv_cpu_cfg(env)->ext_xflashpoint) {
+        return RISCV_EXCP_ILLEGAL_INST;
+    }
+    return RISCV_EXCP_NONE;
+}
+
+static inline int pmp_is_locked(CPURISCVState *env, uint32_t pmp_index)
+{
+    /* mseccfg.RLB is set */
+    if (MSECCFG_RLB_ISSET(env)) {
+        return 0;
+    }
+
+    if (env->pmp_state.pmp[pmp_index].cfg_reg & PMP_LOCK) {
+        return 1;
+    }
+
+    /* Top PMP has no 'next' to check */
+    if ((pmp_index + 1u) >= MAX_RISCV_PMPS) {
+        return 0;
+    }
+
+    return 0;
+}
+
+/*
+ * Accessor method to extract address matching type 'a field' from cfg reg
+ */
+static inline uint8_t pmp_get_a_field(uint8_t cfg)
+{
+    uint8_t a = cfg >> 3;
+    return a & 0x3;
+}
+
+int riscv_exit_anchor(CPURISCVState *env, target_ulong jump_address, target_ulong _unused) {
+    /* jump_address: address to jump to after locking the pmp entry 0 */ 
+
+    RISCVException ret = riscv_xflashpoint_check(env);
+    if (ret != RISCV_EXCP_NONE) {
+        return ret;
+    }
+
+    if (pmp_get_a_field(env->pmp_state.pmp[0].cfg_reg) == PMP_AMATCH_OFF && pmp_get_a_field(env->pmp_state.pmp[1].cfg_reg) != PMP_AMATCH_TOR) {
+        qemu_printf(
+            "pmp locking - PMP entry 0 is not configured\n");
+        return RISCV_EXCP_ILLEGAL_INST; 
+    }
+
+    // Check that ePMP is disabled! 
+    if (MSECCFG_RLB_ISSET(env) || MSECCFG_MML_ISSET(env) || MSECCFG_MMWP_ISSET(env)) { 
+        qemu_printf(
+            "ePMP is enabled\n");
+        return RISCV_EXCP_ILLEGAL_INST; 
+    }
+
+    // Lock the first entry 
+    
+    if (pmp_get_a_field(env->pmp_state.pmp[0].cfg_reg) != PMP_AMATCH_OFF) {
+        env->pmp_state.pmp[0].cfg_reg |= PMP_LOCK;
+    } else if (pmp_get_a_field(env->pmp_state.pmp[1].cfg_reg) == PMP_AMATCH_TOR) {
+        // If TOR and Locked, writes to -1 should be ignored as per the spec
+        env->pmp_state.pmp[0].cfg_reg |= PMP_LOCK;
+        env->pmp_state.pmp[1].cfg_reg |= PMP_LOCK;
+    } else {
+        //THIS SHOULD NEVER HAPPEN 
+        assert(0);
+    }
+
+    return 0; 
+}
+
+
+int riscv_enter_anchor(CPURISCVState *env, target_ulong exit_address, target_ulong exit_region_size, target_ulong* anchor_entry_address) {
+
+    RISCVException ret = riscv_xflashpoint_check(env);
+    if (ret != RISCV_EXCP_NONE) {
+        return ret;
+    }
+
+    // Check that ePMP is disabled! 
+    if (MSECCFG_RLB_ISSET(env) || MSECCFG_MML_ISSET(env) || MSECCFG_MMWP_ISSET(env)) { 
+        qemu_printf(
+            "ePMP is enabled\n");
+            return -1; 
+    }
+
+    /* 
+    if (!pmp_is_locked(env, pmp_index)) {
+        // This is an error because if the PMP entry is not locked, you cannot unlock and shouldn't jump... 
+        qemu_printf(
+            "unlock attempt on an unlocked PMP entry\n");
+            return -1; 
+    } */ 
+
+    if (pmp_get_a_field(env->pmp_state.pmp[0].cfg_reg) == PMP_AMATCH_OFF && pmp_get_a_field(env->pmp_state.pmp[1].cfg_reg) != PMP_AMATCH_TOR) {
+        qemu_printf(
+            "pmp locking - PMP entry 0 is not configured\n");
+        return RISCV_EXCP_ILLEGAL_INST; 
+    }
+
+    // Unlock all the entries
+    for (int pmp_index = 0; pmp_index < MAX_RISCV_PMPS; pmp_index++) {
+        if (pmp_is_locked(env, pmp_index)) {
+            env->pmp_state.pmp[pmp_index].cfg_reg &= ~(PMP_LOCK);
+        }
+    }
+
+    // Disable interrupts
+    env->mstatus &= ~(MSTATUS_MIE);
+
+    if (pmp_get_a_field(env->pmp_state.pmp[0].cfg_reg) != PMP_AMATCH_OFF) {
+        *anchor_entry_address = env->pmp_state.addr[0].sa;
+    } else if (pmp_get_a_field(env->pmp_state.pmp[1].cfg_reg) == PMP_AMATCH_TOR) {
+        *anchor_entry_address = env->pmp_state.addr[1].sa;
+    } else {
+        //THIS SHOULD NEVER HAPPEN 
+        assert(0);
+    }
+
+    return 0;
+}

diff --git a/backends/tpm/tpm_emulator.c b/backends/tpm/tpm_emulator.c
index aa05dab6aef741202b6b6f1f0c782c93cbda11e5..8f4142567dc6136fab33e3f1994f2bda78ed01b0 100644
--- a/backends/tpm/tpm_emulator.c
+++ b/backends/tpm/tpm_emulator.c
@@ -697,6 +697,46 @@ static TpmTypeOptions *tpm_emulator_get_tpm_options(TPMBackend *tb)
     return options;
 }
 
+static int tpm_emulator_hash_start(TPMBackend *tb)
+{
+    TPMEmulator *tpm_emu = TPM_EMULATOR(tb);
+    ptm_res res;
+    if (tpm_emulator_ctrlcmd(tpm_emu, CMD_HASH_START, &res, 0, sizeof(ptm_res), sizeof(res)) < 0) {
+        error_report("tpm-emulator: Could not start hashing on locality 4 :  %s",
+                     strerror(errno));
+        return -1;
+    }
+    return 0;
+}
+
+static int tpm_emulator_hash_data(TPMBackend *tb, uint8_t * data, size_t sdata)
+{
+    TPMEmulator *tpm_emu = TPM_EMULATOR(tb);
+    ptm_hdata dat;
+    dat.u.req.length = cpu_to_be32((uint32_t )sdata);
+    memset(dat.u.req.data, 0, sdata);
+    memcpy(dat.u.req.data, data, sdata);
+    uint64_t in_size = sizeof(uint32_t) + sdata*sizeof(uint8_t);
+    if (tpm_emulator_ctrlcmd(tpm_emu, CMD_HASH_DATA, &dat, in_size, sizeof(dat.u.resp.tpm_result), sizeof(ptm_res))< 0) {
+        error_report("tpm-emulator: Could not hash data on locality 4 :  %s",
+                     strerror(errno));
+        return -1;
+    }
+    return 0;
+}
+
+static int tpm_emulator_end_hash(TPMBackend *tb)
+{
+    TPMEmulator *tpm_emu = TPM_EMULATOR(tb);
+    ptm_res res;
+    if (tpm_emulator_ctrlcmd(tpm_emu, CMD_HASH_END, &res, 0, sizeof(ptm_res), sizeof(res)) < 0) {
+        error_report("tpm-emulator: Could not end hashing on locality 4 :  %s",
+                     strerror(errno));
+        return -1;
+    }
+    return 0;
+}
+

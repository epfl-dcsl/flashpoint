@@ -606,6 +606,64 @@ function clause execute (FENCE_TSO(pred, succ)) = {
 mapping clause assembly = FENCE_TSO(pred, succ)
   <-> "fence.tso" ^ spc() ^ fence_bits(pred) ^ sep() ^ fence_bits(succ)
 
+/* ************************ FlashPoint ******************************** */
+union clause ast = ENTER_ANCHOR : (regidx, regidx)
+
+mapping clause encdec = ENTER_ANCHOR(rs1, rs2)
+  <-> 0b0000000 @ rs2 @ rs1 @ 0b001 @ 0b00000 @ 0b0101011
+
+function clause execute ENTER_ANCHOR(rs1, rs2) = {
+  if   cur_privilege != Machine
+  then { handle_illegal(); RETIRE_FAIL }
+  // Todo: illegal if smepmp is enabled
+  else {
+    // set next pc to PMPADDR 0 
+    match get_highest_priority_pmp_sa() {
+      Some(pmp0_sa) => { set_next_pc(pmp0_sa); 
+        // disable interrupts 
+        // Question: Should we do MPIE = MIE, in enter, and then, MIE = MPIE in exit 
+        // Which is similar to what happens in an ecall and mret ... 
+        mstatus[MIE]  = 0b0;
+        // unlock all PMPs 
+        unlock_all_pmps(); 
+        RETIRE_SUCCESS
+      },
+      None() => { handle_illegal(); RETIRE_FAIL },
+    } 
+  }
+}
+
+mapping clause assembly = ENTER_ANCHOR(rs1, rs2)
+  <-> "enter_anchor" ^ spc() ^ reg_name(rs1) ^ sep() ^ reg_name(rs2)
+
+
+/* ************************ FlashPoint ******************************** */
+union clause ast = EXIT_ANCHOR : (regidx, regidx)
+
+mapping clause encdec = EXIT_ANCHOR(rs1, rs2)
+  <-> 0b0000000 @ rs2 @ rs1 @ 0b000 @ 0b00000 @ 0b0101011
+
+function clause execute EXIT_ANCHOR(rs1, rs2) = {
+  if   cur_privilege != Machine
+  then { handle_illegal(); RETIRE_FAIL }
+  // Todo: illegal if smepmp is enabled 
+  else {
+    // lock PMP 0 
+    if lock_highest_priority_pmp()
+    then {
+      // set next pc to exit addr
+      set_next_pc(X(rs1));
+      RETIRE_SUCCESS
+    } else {
+      handle_illegal(); RETIRE_FAIL
+    }
+  }
+}
+
+mapping clause assembly = EXIT_ANCHOR(rs1, rs2)
+  <-> "exit_anchor" ^ spc() ^ reg_name(rs1) ^ sep() ^ reg_name(rs2)
+
+
 /* ****************************************************************** */
 union clause ast = ECALL : unit
 

index c662da2..a0b0bc0 100644
--- a/model/riscv_pmp_control.sail
+++ b/model/riscv_pmp_control.sail
@@ -126,6 +126,60 @@ function pmpCheck forall 'n, 'n > 0. (addr: physaddr, width: int('n), acc: Acces
   if priv == Machine then None() else Some(accessToFault(acc))
 }
 
+function lock_highest_priority_pmp() -> bool = {
+  assert(
+    sys_pmp_count() == 16 | sys_pmp_count() == 64,
+    "sys_pmp_count() must be non-zero: 16, or 64"
+  );
+
+  match pmpAddrMatchType_of_bits(pmpcfg_n[0][A]) {
+    NAPOT => { pmpcfg_n[0][L] = 0b1; return true; },
+    OFF   => { 
+      match pmpAddrMatchType_of_bits(pmpcfg_n[1][A]) {
+        TOR => { pmpcfg_n[1][L] = 0b1; return true; },
+        _   => { return false; },
+      }
+    },
+    _     => { return false; },
+  }
+}
+
+function unlock_all_pmps() -> unit = {
+  // This is the only way to unlock previously locked PMPs. 
+  // This should NOT be used outside of the enter_anchor instruction.
+  assert(
+    sys_pmp_count() == 16 | sys_pmp_count() == 64,
+    "sys_pmp_count() must be non-zero: 16, or 64"
+  );
+
+  foreach (i from 0 to 63) {
+    pmpcfg_n[i] = [pmpcfg_n[i] with L = 0b0];
+  };
+}
+
+function get_highest_priority_pmp_sa() -> option(xlenbits) = {
+  match pmpAddrMatchType_of_bits(pmpcfg_n[0][A]) {
+    NAPOT => { 
+      match pmpAddrRange(pmpcfg_n[0], pmpReadAddrReg(0), zeros()) {
+        Some(lo, hi) => return Some(lo),
+        _            => return None(),
+      }
+    },
+    OFF   => { 
+      match pmpAddrMatchType_of_bits(pmpcfg_n[1][A]) {
+        TOR => { 
+          match pmpAddrRange(pmpcfg_n[1], pmpReadAddrReg(1), pmpReadAddrReg(0)) {
+            Some(lo, hi) => return Some(lo),
+            _            => return None(),
+          } 
+        },
+        _   => { return None(); },
+      }
+    },
+    _     => { return None(); },
+  } 
+}
+
 function init_pmp() -> unit = {
   assert(
     sys_pmp_count() == 0 | sys_pmp_count() == 16 | sys_pmp_count() == 64,

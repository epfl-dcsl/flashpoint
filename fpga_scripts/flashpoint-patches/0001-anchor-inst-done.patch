   ) = {
     val pmpCfgPerCSR = PMXLEN / new PMPConfig().getWidth
     def pmpCfgIndex(i: Int) = (PMXLEN / 32) * (i / pmpCfgPerCSR)
@@ -325,6 +327,21 @@ trait PMPMethod extends PMPConst {
       ))
     }).fold(Map())((a, b) => a ++ b) // ugly code, hit me if u have better codes
 
+    if (cfgBase == PmpcfgBase) {
+      // only handle Pmpcfg
+      println("Debug: PMP CFG code block called")
+
+      // val vec = cfgMerged.asTypeOf(Vec(num / pmpCfgPerCSR, Vec(pmpCfgPerCSR, new PMPConfig())))
+      when (lockPMP0) {
+        cfgMerged(0) := cfgMerged(0) | 0x80.U
+      }
+      when (unlockAll) {
+        cfgMerged.map {
+          a => a := a & "h_7F7F7F7F7F7F7F7F".U
+        }
+      }
+    }
+
     val addr_mapping = (0 until num).map(i => {Map(
       MaskedRegMap(
         addr = addrBase + i,
@@ -348,12 +365,13 @@ class PMP(implicit p: Parameters) extends PMPXSModule with HasXSParameter with P
   })
 
   val w = io.distribute_csr.w
+  val anchor = io.distribute_csr.anchor
 
   val pmp = Wire(Vec(NumPMP, new PMPEntry()))
   val pma = Wire(Vec(NumPMA, new PMPEntry()))
 
-  val pmpMapping = pmp_gen_mapping(pmp_init, NumPMP, PmpcfgBase, PmpaddrBase, pmp)
-  val pmaMapping = pmp_gen_mapping(pma_init, NumPMA, PmacfgBase, PmaaddrBase, pma)
+  val pmpMapping = pmp_gen_mapping(pmp_init, NumPMP, PmpcfgBase, PmpaddrBase, pmp, unlockAll = anchor.valid && anchor.bits.unlockAll, lockPMP0 = anchor.valid && anchor.bits.lockPMP0)
+  val pmaMapping = pmp_gen_mapping(pma_init, NumPMA, PmacfgBase, PmaaddrBase, pma, unlockAll = 0.B, lockPMP0 = 0.B)
   val mapping = pmpMapping ++ pmaMapping
 
   val rdata = Wire(UInt(PMXLEN.W))
